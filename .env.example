# Google Cloud
# GCP project ID — used for Firestore (glossary) and as fallback Vertex AI project
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Vertex AI region fallback (used when VERTEX_AI_ENDPOINTS is not set)
GOOGLE_CLOUD_LOCATION=us-central1

# Vertex AI endpoints — comma-separated "project:location" pairs.
# Each entry is an independent GCP project with its own quota.
# The quota router assigns a different project to each request (round-robin)
# and falls back to the next project on quota errors (429 / ResourceExhausted).
# On Cloud Run, authentication is handled automatically via ADC (no credentials file needed).
# Leave empty to use GOOGLE_CLOUD_PROJECT + GOOGLE_CLOUD_LOCATION as a single endpoint.
VERTEX_AI_ENDPOINTS=digital-translation-p1:us-central1,digital-translation-p2:us-central1,digital-translation-p3:us-central1

# Gemini model
# Model ID to use for translation and evaluation DO NOT CHANGE UNLESS YOU KNOW WHAT YOU ARE DOING. The system is tested and optimized for this specific model version, and changing it may lead to unexpected behavior or errors.
GEMINI_MODEL=gemini-2.5-flash

# Logging
# Log verbosity level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Whether to write cost entries to costs_log.md in addition to the console
LOG_TO_FILE=False

# LLM retry settings
# Total number of attempts per LLM call (1 initial + N-1 retries)
LLM_MAX_RETRIES=3
# Fixed delay in seconds between retry attempts
LLM_RETRY_DELAY_SECONDS=2.0

# Evaluator (LLM-as-Judge quality scoring)
# Set to true to enable per-field quality scoring after translation
EVAL=false

# Glossary admin
# Password for the glossary management UI
GLOSSARY_ADMIN_PASSWORD=change-me

# Firestore (glossary)
# Firestore database name used for the glossary
FIRESTORE_DATABASE=glossarydb
# Firestore collection name for glossary entries
FIRESTORE_COLLECTION=glossary_entries
