                <mxCell id="60" value="&lt;font style=&quot;font-size: 11px; color: #00695C;&quot;&gt;&lt;b&gt;Cloud VPN (HA VPN)&lt;/b&gt;&lt;br&gt;Encrypted Tunnel (IPsec)&lt;br&gt;&lt;i&gt;Async HTTPS&lt;/i&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00796B;strokeWidth=3;dashed=1;dashPattern=8 8;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;curved=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="21" target="31" edge="1">
