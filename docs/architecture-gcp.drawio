                <mxCell id="212" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Encrypted Connection (HA VPN / IPsec)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="385" y="1290" width="230" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="214" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Data Flow / API Call&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="385" y="1325" width="130" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="215" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Cross-Project (Internal GCP backbone)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="385" y="1360" width="230" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="216" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Secrets / Configuration Access&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="385" y="1395" width="190" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="218" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Logging / Metrics / Tracing&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="385" y="1430" width="160" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="220" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;ARCHITECTURE NOTES&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0E0E0;strokeColor=#757575;strokeWidth=2;verticalAlign=top;arcSize=4;align=center;" parent="1" vertex="1">
                    <mxGeometry x="610" y="1228" width="1950" height="460" as="geometry"/>
                </mxCell>
                <mxCell id="221" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Networking:&lt;/b&gt;&lt;br&gt;• All components in one unified GCP cloud (K+1 projects).&lt;br&gt;• VPC with 3 subnets in us-central1:&lt;br&gt;   — Application Subnet (10.0.1.0/24): General-purpose, PGA enabled.&lt;br&gt;   — Connector Subnet (10.0.2.0/28): Dedicated /28 for VPC Access Connector.&lt;br&gt;   — Proxy-Only Subnet (10.0.3.0/24): Internal ALB Envoy proxies (GCP-managed).&lt;br&gt;• Private Google Access — all GCP APIs (including Vertex AI) accessed privately.&lt;br&gt;• Cloud Firestore for glossary (native mode, kind-specific queries, 300s cache).&lt;br&gt;• VPC Firewall Rules: Ingress from VPN source ranges only, egress HTTPS only.&lt;br&gt;• On-Prem to GCP: Cloud VPN (HA VPN) with IPsec tunnels (99.99% SLA).&lt;br&gt;• Cloud Run → Vertex AI: Cross-project calls on GCP internal backbone.&lt;br&gt;&lt;br&gt;&lt;b&gt;Security:&lt;/b&gt;&lt;br&gt;• GCP service account credentials stored in Secret Manager (no hardcoded secrets).&lt;br&gt;• Cloud Run service account with least-privilege IAM roles.&lt;br&gt;• Cloud KMS (CMEK) for Cloud Firestore encryption at rest.&lt;br&gt;• All traffic encrypted in transit (TLS 1.3).&lt;br&gt;• Optional: VPC Service Controls for data perimeter.&lt;br&gt;&lt;br&gt;&lt;b&gt;Observability:&lt;/b&gt;&lt;br&gt;• Cloud Logging: Structured JSON logs with correlation IDs for request tracing.&lt;br&gt;• Cloud Monitoring: Custom metrics — success rate, latency (p50, p95, p99), quota.&lt;br&gt;• Alerting Policies: Error rate thresholds, high latency, quota limits.&lt;br&gt;• Cloud Trace: Distributed tracing for end-to-end request latency analysis.&lt;br&gt;&lt;br&gt;&lt;b&gt;Scalability:&lt;/b&gt;&lt;br&gt;• Serverless: Cloud Run auto-scales (including to zero) based on request volume.&lt;br&gt;• K GCP projects multiply available Vertex AI quota by K.&lt;br&gt;• Quota Router: Stateless round-robin distributes load evenly across projects.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="630" y="1260" width="600" height="340" as="geometry"/>
                </mxCell>
                <mxCell id="222" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;Data Flow:&lt;/b&gt;&lt;br&gt;1. Client sends translation request to Internal ALB via encrypted HA VPN tunnel.&lt;br&gt;2. Internal ALB routes to Cloud Run service (internal ingress only).&lt;br&gt;3. Cloud Run fetches credentials from Secret Manager (via PGA).&lt;br&gt;4. Glossary loaded from Cloud Firestore (filtered by kind, cached 300s).&lt;br&gt;5. Quota Router selects project-llm-* using round-robin algorithm.&lt;br&gt;6. Language detection via Unicode script analysis + langdetect.&lt;br&gt;7. Batch Translation Engine calls Vertex AI (one call per instruction group).&lt;br&gt;8. LLM-as-Judge batch-scores translations (faithfulness, fluency,&lt;br&gt;   glossary compliance; weighted 60/20/20).&lt;br&gt;9. Cloud Run emits logs/metrics to Cloud Logging / Cloud Monitoring.&lt;br&gt;10. Response returned to client via Internal ALB → VPN.&lt;br&gt;&lt;br&gt;&lt;b&gt;Deployment:&lt;/b&gt;&lt;br&gt;• Cloud Run packaged as Docker container in Artifact Registry.&lt;br&gt;• Glossary in Cloud Firestore (CMEK encrypted, kind-specific).&lt;br&gt;• Infrastructure managed via Terraform.&lt;br&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="1254" width="460" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="61" value="" style="rounded=1;html=1;strokeColor=#2E7D32;strokeWidth=2;dashed=1;dashPattern=8 8;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;exitX=0.995;exitY=0.942;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitPerimeter=0;edgeStyle=orthogonalEdgeStyle;" parent="1" source="32" target="49" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1000" y="788"/>
                            <mxPoint x="1000" y="590"/>
                            <mxPoint x="1590" y="590"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="63" value="" style="rounded=1;html=1;strokeColor=#2E7D32;strokeWidth=2;dashed=1;dashPattern=8 8;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;exitX=1.001;exitY=0.879;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitPerimeter=0;edgeStyle=orthogonalEdgeStyle;" parent="1" source="32" target="53" edge="1">
