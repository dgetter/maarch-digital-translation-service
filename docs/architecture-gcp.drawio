                </mxCell>
                <mxCell id="209" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Vertex AI Quota Project (project-llm-*)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
