                </mxCell>
                <mxCell id="62" value="&lt;font style=&quot;font-size: 11px; color: rgb(0, 105, 92);&quot;&gt;&lt;b&gt;Cross-Project (Internal GCP)&lt;/b&gt;&lt;br&gt;&lt;i&gt;google-genai SDK&lt;br&gt;via Private Google Access&lt;/i&gt;&lt;/font&gt;" style="rounded=1;html=1;strokeColor=#2E7D32;strokeWidth=3;dashed=1;dashPattern=8 8;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" parent="1" edge="1">
                    <mxGeometry x="-0.3616" y="-10" relative="1" as="geometry">
